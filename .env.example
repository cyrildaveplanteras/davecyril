# Database Configuration
# These match the packaged defaults in db-config.json.
# IMPORTANT: Set a strong password for production!
# Generate with: openssl rand -base64 32
# On a fresh install GoldenHope asks for these values on first launch and stores
# them in %LOCALAPPDATA%\GoldenHope\db-config.json. Only set DB_PASSWORD here if
# you deliberately want this file to override that saved configuration.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=goldenhope
DB_PASSWORD=
DB_NAME=goldenhope_db
DB_TIMEZONE=+08:00
DB_CONNECTION_LIMIT=10