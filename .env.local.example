# Local development / signing configuration.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Optional: override database port used by auto-postgres in dev.
# DB_PORT=5433

# Code-signing for local `npm run dist:win` (same variables GitHub Actions uses).
# CSC_LINK can be a file path to the .pfx or its raw base64 contents.
CSC_LINK=goldenhope-code-signing.pfx
CSC_KEY_PASSWORD=replace-with-your-certificate-password